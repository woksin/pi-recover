{
  "name": "@woksin/pi-recover",
  "version": "0.1.0",
  "description": "Recover unfinished pi subagents, workflows and jobs with deterministic session reports and /recover",
  "license": "MIT",
  "author": "woksin",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "recovery",
    "subagents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woksin/pi-recover.git"
  },
  "homepage": "https://github.com/woksin/pi-recover#readme",
  "bugs": {
    "url": "https://github.com/woksin/pi-recover/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "type": "module",
  "scripts": {
    "test": "node --test --test-timeout=30000 'test/*.test.ts'",
    "scan": "node scripts/scan.ts",
    "typecheck": "node scripts/typecheck.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.19"
  }
}
